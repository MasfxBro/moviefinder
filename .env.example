APP_NAME=MovieFinder
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://moviefinder.test
APP_TIMEZONE=UTC
BUSINESS_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=moviefinder
DB_USERNAME=moviefinder
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@moviefinder.test
MAIL_FROM_NAME="${APP_NAME}"

TMDB_READ_TOKEN=
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/

AI_DRIVER=fake
GEMINI_API_KEY_FREE=
GEMINI_API_KEY_PAID=
AI_MODEL_STANDARD=gemini-3.5-flash-lite
AI_MODEL_SMART=gemini-3.8-flash
AI_GLOBAL_DAILY_CAP=10000

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

LAUNCH_MODE=demo

ADMIN_PATH=
ADMIN_ALLOWED_IPS=
ADMIN_EMAIL=

VITE_APP_NAME="${APP_NAME}"
